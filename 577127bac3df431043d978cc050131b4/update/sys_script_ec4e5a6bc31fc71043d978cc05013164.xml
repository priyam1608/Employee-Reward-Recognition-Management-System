        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	var allocatedBudget = parseFloat(current.getValue('allocated_budget'));
	var consumedBudget = parseFloat(current.getValue('consumed_budget'));

	if(allocatedBudget < 0){
		gs.addErrorMessage('Allocated Budget Cannot Be Negative');
		current.setAbortAction(true);
	}
	else if(consumedBudget < 0){
		gs.addErrorMessage('Consumed Budget Cannot Be Negative');
		current.setAbortAction(true);
	}
	else if(allocatedBudget < consumedBudget){
		gs.addErrorMessage('Consumed Budget Cannot Be Greater Than Allocated Budget');
		current.setAbortAction(true);
	}

})(current, previous);]]></script>
