<?xml version="1.0" encoding="UTF-8"?><record_update sys_domain="global" table="sys_script_client">
    <sys_script_client action="INSERT_OR_UPDATE">
        <active>true</active>
        <applies_extended>false</applies_extended>
        <condition/>
        <description>Min Value cannot be negative</description>
        <field>min_value</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>min_value onChange Validation</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading || newValue === '') {
      return;
   }
   var cleanMinValue = parseFloat(g_form.getValue('min_value').split(';')[1].replace(',',''));

   if(cleanMinValue < 0){
	g_form.showFieldMsg('min_value', 'Minimum Value Cannot Be Negative', 'error');
   }
   else{
	g_form.hideFieldMsg('min_value');
   }
   
}]]></script>
