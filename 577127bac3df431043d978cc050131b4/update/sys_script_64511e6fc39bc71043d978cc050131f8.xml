        gs.addErrorMessage('Minimum Value Cannot Be Negative');
        current.setAbortAction(true);
    } else if (cleanMaxValue < 0) {
        gs.addErrorMessage('Maximum Value Cannot Be Negative');
        current.setAbortAction(true);
