        <field>allocated_budget</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Allocated Budget Validation onChange</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading || newValue === '') {
      return;
   }

   var allocatedBudgetVal = parseFloat(newValue.split(';')[1].replace(',',''));

   if(allocatedBudgetVal < 0){
	g_form.showFieldMsg('allocated_budget', 'Allocated Budget Cannot Be Negative', 'error');
   }
   else{
	g_form.hideFieldMsg('allocated_budget');
   }
   
   
}]]></script>
