<?xml version="1.0" encoding="UTF-8"?><record_update sys_domain="global" table="sys_script_client">
    <sys_script_client action="INSERT_OR_UPDATE">
        <active>true</active>
        <applies_extended>false</applies_extended>
        <condition/>
        <description>Auto populate department from employee field using script include</description>
        <field>employee</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Auto-Populate Dept onChange Employee</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading || newValue === '') {
      return;
   }
   var ga = new GlideAjax('RewardUtils');
   ga.addParam('sysparm_name', 'getDepartment');
   ga.addParam('sysparm_empid', newValue);
   ga.getXMLAnswer(function(answer){
	g_form.setValue('department', answer);
	});
}]]></script>
