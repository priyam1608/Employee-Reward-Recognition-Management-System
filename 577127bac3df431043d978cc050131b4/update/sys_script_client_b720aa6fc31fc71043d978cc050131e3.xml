<?xml version="1.0" encoding="UTF-8"?><record_update sys_domain="global" table="sys_script_client">
    <sys_script_client action="INSERT_OR_UPDATE">
        <active>true</active>
        <applies_extended>false</applies_extended>
        <condition/>
        <description>Amount cannot be negative</description>
        <field>amount</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Amount Validation</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading || newValue === '') {
      return;
   }

   var cleanAmountVal = parseFloat(newValue.split(';')[1].replaceAll(',',''));

   if(cleanAmountVal < 0){
	g_form.showFieldMsg('amount', 'Amount Cannot Be Negative', 'error');
   }
   else{
	g_form.hideFieldMsg('amount');
   }
   
}]]></script>
