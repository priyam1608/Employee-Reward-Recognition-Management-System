<?xml version="1.0" encoding="UTF-8"?><record_update sys_domain="global" table="sys_script_client">
    <sys_script_client action="DELETE">
        <active>true</active>
        <applies_extended>false</applies_extended>
        <condition/>
        <description>Amount - Mandatory only when reward type is monetary;&#13;
Leave days - Mandatory only when reward type = Extra Leave Credit&#13;
</description>
        <field>reward_type</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Set Mandatory onChange Reward Type</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading || newValue === '') {
      return;
   }

   var rewardType = g_form.getDisplayValue('reward_type');
   
   switch(rewardType){
	case "Extra Leave Credit":
		g_form.setMandatory('amount', false);
		g_form.setMandatory('leave_days', true);
		break;
	
	case "Spot Bonus - High Value":
	case "Voucher - Gift Card":
	case "Team Recognition Award":
		g_form.setMandatory('amount', true);
		g_form.setMandatory('leave_days', false);
		break;

	default:
		break;
   }
   
}]]></script>
