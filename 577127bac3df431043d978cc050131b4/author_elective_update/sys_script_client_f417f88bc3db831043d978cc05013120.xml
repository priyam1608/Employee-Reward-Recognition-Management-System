        <name>min_max_value onSubmit Validation</name>
        <order/>
        <script><![CDATA[function onSubmit() {
   var cleanMinValue = parseFloat(g_form.getValue('min_value').split(';')[1].replace(',',''));
   var cleanMaxValue = parseFloat(g_form.getValue('max_value').split(';')[1].replaceAll(',',''));

   if(cleanMinValue < 0){
	g_form.showFieldMsg('min_value', 'Minimum Value Cannot Be Negative', 'error');
	return false;
   }

   if(cleanMaxValue < 0){
	g_form.showFieldMsg('max_value', 'Maximum Value Cannot Be Negative', 'error');
	return false;
   }
   if(cleanMaxValue < cleanMinValue){
	g_form.showFieldMsg('max_value', 'Maximum Value Cannot Be Less Than Minimum Value', 'error');
	return false;
   }

   return true;
   
}]]></script>
