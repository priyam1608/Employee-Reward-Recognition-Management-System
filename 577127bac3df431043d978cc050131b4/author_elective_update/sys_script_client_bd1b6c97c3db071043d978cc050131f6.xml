        <condition/>
        <description>Minimum 50 characters are required in 'justification' field</description>
        <field/>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Minimum 50 characters in justification</name>
        <order/>
        <script><![CDATA[function onSubmit() {
   
   var justification = g_form.getValue('justification');

   if(justification.length < 50){
	g_form.showFieldMsg('justification','Justification can not be less than 50 characters','error');
	return false;
   }
   
   g_form.hideFieldMsg('justification');
   return true;
   
}]]></script>
