        <name>max_value onChange Client Script</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading || newValue === '') {
      return;
   }
   
   var cleanMinValue = g_form.getValue('min_value').split(';')[1];

   var cleanMaxValue = newValue.split(';')[1];
   if(cleanMaxValue < 0){
	g_form.showFieldMsg('max_value', 'Maximum Value Cannot Be Negative', 'error');
   }
   else if(cleanMaxValue < cleanMinValue){
	g_form.showFieldMsg('max_value', 'Maximum Value Cannot Be Less Than Minimum Value', 'error');
   }
   else{
	g_form.hideFieldMsg('max_value');
   }
   
}]]></script>
